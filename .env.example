# ---- Zorunlu ----
DATABASE_URL="postgresql://toto:toto@localhost:5432/spor_toto"
# Yenileme, kupon kaydı ve ayarlar için yönetici anahtarı (uzun rastgele bir değer: `openssl rand -hex 32`)
ADMIN_TOKEN=""

# ---- Ücretsiz anahtar gerektiren kaynaklar (boş bırakılırsa kaynak "API anahtarı eksik" görünür) ----
# https://dashboard.api-football.com/register  (ücretsiz: günde 100 istek)
API_FOOTBALL_KEY=""
API_FOOTBALL_DAILY_LIMIT=100
# https://www.football-data.org/client/register  (ücretsiz: 12 büyük turnuva)
FOOTBALL_DATA_ORG_KEY=""
# https://the-odds-api.com/#get-access  (ücretsiz: ayda 500 istek)
ODDS_API_KEY=""

# ---- Opsiyonel, ücretli ----
# https://console.anthropic.com  — uzman yazılarından alıntı doğrulamalı tahmin çıkarma
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Claude ile okunacak uzman yazısı bağlantıları (virgülle ayrılmış)
EXPERT_ARTICLE_URLS=""

# ---- Diğer ----
# Ek tahmin bloğu RSS/Atom akışları (virgülle)
EXPERT_FEEDS=""
# Kurulum ekranından ayar yapılmadıysa kullanılan kolon fiyatı (doğrulanmamış olarak gösterilir)
DEFAULT_COLUMN_PRICE=10
