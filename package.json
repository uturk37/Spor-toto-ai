    "db:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test:e2e": "vitest run tests/pipeline.e2e.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "next": "^15.5.29",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
