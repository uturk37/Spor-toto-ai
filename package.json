{
  "name": "spor-toto-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Spor Toto AI – akıllı maç analiz ve kupon sistemi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "refresh": "tsx src/worker/cli.ts refresh",
    "grade": "tsx src/worker/cli.ts grade",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
